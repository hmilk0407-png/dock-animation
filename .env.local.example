# --- Supabase (プロジェクト設定 > API からコピー) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Anthropic (サーバー側のみで使用。クライアントには絶対に出ない) ---
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google カレンダー連携 (Apps Script → /api/calendar/ingest) ---
# Apps Script の「スクリプト プロパティ」SECRET と同じ値
CALENDAR_SECRET=change-me-to-a-long-random-string
# Supabase > Settings > API Keys の service_role (secret) キー。サーバー側のみで使用
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
